---
import Layout from '../layouts/Layout.astro';
import ActivityFeed from '../components/ActivityFeed.astro';
import { foreverRoster as r, nameClass, classKey, classBg, classText, timeAgo } from '../data/foreverRoster';
import { classInterest, roleInterest, factionInterest, totalResponses } from '../data/wowForever';

const maxLevel = r?.maxLevel ?? 60;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Pre-launch survey (archived at the bottom of the page)
const surveyClasses = Object.entries(classInterest).sort((a, b) => b[1] - a[1]);
const maxSurvey = Math.max(...surveyClasses.map(([, n]) => n));
---

<Layout title="WoW: Forever Roster" description="Every Goat Guild character in WoW: Forever: names, classes, levels, and who's climbing fastest.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-amber-900/25 via-midnight-900 to-midnight-900"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center mb-10">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-accent-gold mb-3">The Forever Roster</h1>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">
          Every goat in WoW: Forever, how high they've climbed, and who's leveling fastest this week.
        </p>
      </div>

      {r ? (
        <div class="grid lg:grid-cols-3 gap-8">
          <!-- Full roster -->
          <div class="lg:col-span-2 bg-midnight-700 rounded-xl border border-midnight-500 overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-midnight-500">
              <h2 class="font-display text-xl font-semibold text-gray-100">{r.total} characters</h2>
              <span class="text-sm text-gray-400"><span class="text-accent-gold font-semibold">{r.atMax}</span> at {maxLevel} · avg {r.averageLevel}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left text-gray-400 border-b border-midnight-600">
                    <th class="py-2 pl-5 pr-2 font-medium w-10">#</th>
                    <th class="py-2 px-2 font-medium">Character</th>
                    <th class="py-2 px-2 font-medium w-40">Level</th>
                    <th class="py-2 px-2 font-medium text-right">This week</th>
                    <th class="py-2 pl-2 pr-5 font-medium text-right whitespace-nowrap">Last ding</th>
                  </tr>
                </thead>
                <tbody>
                  {r.members.map((m, i) => {
                    const cls = classKey(m.classId);
                    return (
                      <tr class="border-b border-midnight-600/60 last:border-0 hover:bg-midnight-600/30">
                        <td class="py-2 pl-5 pr-2 text-gray-500">{i + 1}</td>
                        <td class="py-2 px-2">
                          <div class={`font-medium ${nameClass(m.classId)}`}>{m.name}</div>
                          {cls && <div class="text-xs text-gray-500">{cap(cls)}</div>}
                        </td>
                        <td class="py-2 px-2">
                          <div class="flex items-center gap-2">
                            <span class={`w-6 font-mono ${m.level >= maxLevel ? 'text-accent-gold font-bold' : 'text-gray-200'}`}>{m.level}</span>
                            <div class="flex-1 bg-midnight-900 rounded-full h-2 overflow-hidden min-w-16">
                              <div class={`h-2 rounded-full ${cls ? classBg[cls] : 'bg-gray-400'}`} style={`width: ${Math.min(100, (m.level / maxLevel) * 100)}%`}></div>
                            </div>
                          </div>
                        </td>
                        <td class="py-2 px-2 text-right font-mono">
                          {m.gainedThisWeek > 0 ? <span class="text-green-400">+{m.gainedThisWeek}</span> : <span class="text-gray-600">–</span>}
                        </td>
                        <td class="py-2 pl-2 pr-5 text-right text-gray-400 whitespace-nowrap">
                          {m.lastLevelUp ? <time datetime={m.lastLevelUp} data-ago>{timeAgo(m.lastLevelUp)}</time> : <span class="text-gray-600">–</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Sidebar: activity + climbers -->
          <div class="space-y-6">
            <div class="bg-midnight-700 rounded-xl border border-midnight-500 p-5">
              <h2 class="font-display text-lg font-semibold text-gray-100 mb-4">Recent activity</h2>
              <ActivityFeed events={r.activity} maxLevel={maxLevel} limit={20} />
            </div>
            {r.climbers.length > 0 && (
              <div class="bg-midnight-700 rounded-xl border border-midnight-500 p-5">
                <h2 class="font-display text-lg font-semibold text-gray-100 mb-4">Top climbers this week</h2>
                <ol class="space-y-2">
                  {r.climbers.map((m, i) => (
                    <li class="flex items-center gap-2 text-sm">
                      <span class="w-4 text-right text-gray-500">{i + 1}.</span>
                      <span class={`flex-1 truncate font-medium ${nameClass(m.classId)}`}>{m.name}</span>
                      <span class="text-gray-400 font-mono text-xs">lv {m.level}</span>
                      <span class="w-8 text-right text-green-400 font-mono">+{m.gainedThisWeek}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
            <p class="text-xs text-gray-500 px-1">
              Synced from the Blizzard API. Last update {new Date(r.updatedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' })} ET.
            </p>
          </div>
        </div>
      ) : (
        <div class="max-w-xl mx-auto text-center bg-midnight-700 rounded-xl border border-amber-700/40 p-10">
          <img src="/images/pixel goat small.png" alt="" class="w-10 h-10 mx-auto mb-3 opacity-80" />
          <p class="text-gray-200 font-medium mb-1">No roster data yet.</p>
          <p class="text-sm text-gray-400">Character names, levels, and level-ups appear here after the first sync with Blizzard.</p>
        </div>
      )}

      <!-- Archive: the pre-launch interest survey -->
      <details class="mt-12 bg-midnight-800 rounded-lg border border-midnight-500">
        <summary class="cursor-pointer p-4 font-semibold text-gray-300 hover:bg-midnight-700 rounded-lg transition-colors">
          Pre-launch survey ({totalResponses} responses)
        </summary>
        <div class="p-5 pt-1 grid md:grid-cols-3 gap-6">
          <div class="md:col-span-2 space-y-2">
            <p class="text-sm text-gray-400 mb-3">What members said they planned to play before launch (multiple picks allowed).</p>
            {surveyClasses.map(([cls, count]) => (
              <div class="flex items-center gap-3">
                <span class={`w-16 shrink-0 text-sm font-medium ${classText[cls]}`}>{cap(cls)}</span>
                <div class="flex-1 bg-midnight-900 rounded-full h-3 overflow-hidden">
                  <div class={`h-3 rounded-full ${classBg[cls]}`} style={`width: ${(count / maxSurvey) * 100}%`}></div>
                </div>
                <span class="w-5 text-right text-sm text-gray-300">{count}</span>
              </div>
            ))}
          </div>
          <div class="space-y-2 text-sm">
            {['Tank', 'Healer', 'DPS'].map(role => (
              <div class="flex justify-between bg-midnight-900/60 rounded px-3 py-1.5"><span class="text-gray-300">{role}</span><span class="text-accent-gold">{roleInterest[role] ?? 0}</span></div>
            ))}
            {['Horde', 'Alliance', 'Either'].map(f => (
              <div class="flex justify-between bg-midnight-900/60 rounded px-3 py-1.5"><span class="text-gray-300">{f}</span><span class="text-accent-gold">{factionInterest[f] ?? 0}</span></div>
            ))}
          </div>
        </div>
      </details>
    </div>
  </section>
</Layout>
