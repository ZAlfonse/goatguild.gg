---
import Layout from '../layouts/Layout.astro';
import ActivityFeed from '../components/ActivityFeed.astro';
import DailyClimb from '../components/DailyClimb.astro';
import ClassMix from '../components/ClassMix.astro';
import SummitRegister from '../components/SummitRegister.astro';
import BluePosts from '../components/BluePosts.astro';
import ParallaxSky from '../components/ParallaxSky.astro';
import ClassSprite from '../components/ClassSprite.astro';
import ClassSpriteDefs from '../components/ClassSpriteDefs.astro';
import { foreverRoster as r, nameClass, classKey, classBg, classText, timeAgo } from '../data/foreverRoster';
import { classInterest, roleInterest, factionInterest, totalResponses } from '../data/wowForever';

const maxLevel = r?.maxLevel ?? 60;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Pre-launch survey (archived at the bottom of the page)
const surveyClasses = Object.entries(classInterest).sort((a, b) => b[1] - a[1]);
const maxSurvey = Math.max(...surveyClasses.map(([, n]) => n));

// Where the herd is: characters per 10-level bracket, with the cap in its own column
const brackets = r
  ? [
      ...Array.from({ length: Math.ceil(maxLevel / 10) }, (_, i) => {
        const lo = Math.max(1, i * 10);
        const hi = Math.min(maxLevel - 1, i * 10 + 9);
        return { label: `${lo}–${hi}`, count: r.members.filter(m => m.level >= lo && m.level <= hi).length, cap: false };
      }),
      { label: `${maxLevel}`, count: r.atMax, cap: true },
    ]
  : [];
const maxBracket = Math.max(1, ...brackets.map(b => b.count));
const busiest = brackets.reduce((a, b) => (b.count > a.count ? b : a), brackets[0]);
---

<Layout title="WoW: Forever Roster" description="Every Goat Guild character in WoW: Forever: names, classes, levels, and who's climbing fastest.">
  <ClassSpriteDefs />
  <ParallaxSky artHeight={96} goatAt={0.14} moonAt={0.86} moonHigh={0.34} seed={23} snow class="h-[400px] md:h-[440px] -mt-[67px]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 md:pt-36 text-center">
      <p class="eyebrow mb-4">WoW: Forever</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold text-goat-gold mb-4 tracking-wide hero-title">The Forever Roster</h1>
      <p class="text-base md:text-lg text-gray-300 max-w-2xl mx-auto">
        Every goat in WoW: Forever, how high they've climbed, and who's leveling fastest this week.
      </p>
    </div>
  </ParallaxSky>

  <section class="relative">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-14">

      {r && (
        <div class="panel p-5 mb-10 reveal">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
            <h2 class="section-title text-xl">Where the herd is</h2>
            {busiest && busiest.count > 0 && (
              <span class="text-sm text-gray-400">Most goats are in the {busiest.label} range.</span>
            )}
          </div>
          <div class="flex items-end gap-2 sm:gap-3 h-36">
            {brackets.map(b => (
              <div class="flex-1 h-full flex flex-col items-center justify-end gap-1" title={`${b.count} at ${b.label}`}>
                <span class={`text-xs tabular-nums font-medium ${b.cap ? 'text-goat-gold' : 'text-gray-300'}`}>{b.count}</span>
                <div
                  class={`w-full pixel-col ${b.cap ? 'bg-goat-gold' : 'bg-goat-gold-dark/80'}`}
                  style={`height: ${b.count ? Math.max(4, (b.count / maxBracket) * 100) : 1}%`}
                ></div>
              </div>
            ))}
          </div>
          <div class="flex gap-2 sm:gap-3 mt-2 border-t-2 border-midnight-600 pt-2">
            {brackets.map(b => (
              <span class={`flex-1 text-center text-[10px] sm:text-xs tabular-nums ${b.cap ? 'text-goat-gold font-semibold' : 'text-gray-500'}`}>{b.label}</span>
            ))}
          </div>
        </div>
      )}

      <DailyClimb />

      <ClassMix />

      {r ? (
        <div class="grid lg:grid-cols-3 gap-8">
          <!-- Full roster -->
          <div class="lg:col-span-2 panel overflow-hidden reveal">
            <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-4 border-b-2 border-midnight-600">
              <h2 class="font-display text-xl font-semibold text-gray-100">{r.total} characters</h2>
              <span class="text-sm text-gray-400"><span class="tabular-nums text-goat-gold font-semibold">{r.atMax}</span> at {maxLevel} · avg {r.averageLevel}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left text-gray-500 border-b-2 border-midnight-600 font-pixel text-[10px] uppercase tracking-wider">
                    <th class="py-2 pl-5 pr-2 font-normal w-10">#</th>
                    <th class="py-2 px-2 font-normal">Character</th>
                    <th class="py-2 px-2 font-normal w-40">Level</th>
                    <th class="py-2 px-2 font-normal text-right">This week</th>
                    <th class="py-2 px-2 font-normal text-right whitespace-nowrap">Last ding</th>
                    <th class="py-2 pl-2 pr-5 font-normal text-right whitespace-nowrap">Last seen</th>
                  </tr>
                </thead>
                <tbody>
                  {r.members.map((m, i) => {
                    const cls = classKey(m.classId);
                    return (
                      <tr class="group border-b border-midnight-600/60 last:border-0 hover:bg-midnight-600/30 transition-colors">
                        <td class="py-2 pl-5 pr-2 tabular-nums text-gray-600">{i + 1}</td>
                        <td class="py-2 px-2">
                          <div class="flex items-center gap-3">
                            <ClassSprite cls={cls} class="roster-goat" />
                            <div class="min-w-0">
                              <div class={`font-medium ${nameClass(m.classId)}`}>{m.name}</div>
                              {cls && <div class="text-xs text-gray-500">{cap(cls)}</div>}
                            </div>
                          </div>
                        </td>
                        <td class="py-2 px-2">
                          <div class="flex items-center gap-2">
                            <span class={`w-6 tabular-nums font-medium ${m.level >= maxLevel ? 'text-goat-gold font-bold' : 'text-gray-200'}`}>{m.level}</span>
                            <div class="flex-1 pixel-track h-2 min-w-16">
                              <div class={`pixel-fill ${cls ? classBg[cls] : 'bg-gray-400'}`} style={`width: ${Math.min(100, (m.level / maxLevel) * 100)}%`}></div>
                            </div>
                          </div>
                        </td>
                        <td class="py-2 px-2 text-right tabular-nums font-medium">
                          {m.gainedThisWeek > 0 ? <span class="text-emerald-400">+{m.gainedThisWeek}</span> : <span class="text-gray-600">–</span>}
                        </td>
                        <td class="py-2 px-2 text-right text-gray-400 whitespace-nowrap">
                          {m.lastLevelUp ? <time datetime={m.lastLevelUp} data-ago>{timeAgo(m.lastLevelUp)}</time> : <span class="text-gray-600">–</span>}
                        </td>
                        <td class="py-2 pl-2 pr-5 text-right text-gray-400 whitespace-nowrap">
                          {m.lastLogin ? <time datetime={m.lastLogin} data-ago>{timeAgo(m.lastLogin)}</time> : <span class="text-gray-600">–</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Sidebar: activity + climbers -->
          <div class="space-y-6">
            <SummitRegister />
            <div class="panel p-5 reveal">
              <h2 class="section-title text-lg mb-4">Recent activity</h2>
              <ActivityFeed events={r.activity} maxLevel={maxLevel} limit={20} />
            </div>
            {r.climbers.length > 0 && (
              <div class="panel p-5 reveal">
                <h2 class="section-title text-lg mb-4">Top climbers this week</h2>
                <ol class="space-y-2">
                  {r.climbers.map((m, i) => (
                    <li class="flex items-center gap-2 text-sm">
                      <span class="w-4 text-right tabular-nums text-gray-600">{i + 1}</span>
                      <span class={`flex-1 truncate font-medium ${nameClass(m.classId)}`}>{m.name}</span>
                      <span class="text-gray-500 tabular-nums text-xs">lv {m.level}</span>
                      <span class="w-8 text-right text-emerald-400 tabular-nums font-medium">+{m.gainedThisWeek}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
            <p class="text-xs text-gray-500 px-1">
              Synced from the Blizzard API. Last update {new Date(r.updatedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' })} ET.
            </p>
          </div>
        </div>
      ) : (
        <div class="max-w-xl mx-auto text-center panel panel-gold p-10">
          <img src="/images/pixel goat small.png" alt="" class="w-10 h-10 mx-auto mb-3 opacity-80 pixelated" />
          <p class="text-gray-200 font-medium mb-1">No roster data yet.</p>
          <p class="text-sm text-gray-400">Character names, levels, and level-ups appear here after the first sync with Blizzard.</p>
        </div>
      )}

      <!-- Official WoW: Forever posts -->
      <div class="mt-14 reveal">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-5">
          <h2 class="section-title text-2xl">From Blizzard</h2>
          <span class="text-sm text-gray-400">The latest WoW: Forever posts. Patch notes, hotfixes, the occasional comic.</span>
        </div>
        <BluePosts game="forever" limit={4} />
      </div>

      <!-- Archive: the pre-launch interest survey -->
      <details class="mt-14 pixel-details panel panel-inset">
        <summary>
          Pre-launch survey ({totalResponses} responses)
        </summary>
        <div class="p-5 pt-1 grid md:grid-cols-3 gap-6">
          <div class="md:col-span-2 space-y-2">
            <p class="text-sm text-gray-400 mb-3">What members said they planned to play before launch (multiple picks allowed).</p>
            {surveyClasses.map(([cls, count]) => (
              <div class="flex items-center gap-3">
                <span class={`w-16 shrink-0 text-sm font-medium ${classText[cls]}`}>{cap(cls)}</span>
                <div class="flex-1 pixel-track h-3">
                  <div class={`pixel-fill ${classBg[cls]}`} style={`width: ${(count / maxSurvey) * 100}%`}></div>
                </div>
                <span class="w-5 text-right text-sm text-gray-300">{count}</span>
              </div>
            ))}
          </div>
          <div class="space-y-2 text-sm">
            {['Tank', 'Healer', 'DPS'].map(role => (
              <div class="flex justify-between bg-midnight-900/60 px-3 py-1.5"><span class="text-gray-300">{role}</span><span class="tabular-nums text-goat-gold">{roleInterest[role] ?? 0}</span></div>
            ))}
            {['Horde', 'Alliance', 'Either'].map(f => (
              <div class="flex justify-between bg-midnight-900/60 px-3 py-1.5"><span class="text-gray-300">{f}</span><span class="tabular-nums text-goat-gold">{factionInterest[f] ?? 0}</span></div>
            ))}
          </div>
        </div>
      </details>
    </div>
  </section>
</Layout>

<style is:global>
  /* The goat hops once when you hover its row */
  .group:hover .roster-goat { animation: roster-hop 0.45s steps(1, end); }
  @keyframes roster-hop {
    0%   { transform: translateY(0); }
    25%  { transform: translateY(-3px); }
    50%  { transform: translateY(-5px); }
    75%  { transform: translateY(-2px); }
    100% { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .group:hover .roster-goat { animation: none; }
  }
</style>
