---
import Layout from '../layouts/Layout.astro';
import ProgressionCard from '../components/ProgressionCard.astro';
import AddonList from '../components/AddonList.astro';
import NewsCard from '../components/NewsCard.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import BluePosts from '../components/BluePosts.astro';
import ForeverLeveling from '../components/ForeverLeveling.astro';

import { guild } from '../data/guild';
import { currentTier, midnightS1Tier, twwTier, achievements } from '../data/progression';
import { allNews } from '../data/news';

const pinnedNews = allNews.filter(n => n.pinned);
const recentNews = allNews.filter(n => !n.pinned).slice(0, 4);

const nextRaidFormatted = new Date(guild.nextRaidDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
// Don't advertise a raid date that has already passed
const nextRaidIsUpcoming = guild.nextRaidDate >= new Date().toISOString().slice(0, 10);
---

