  <!-- Hero: WoW: Forever is the guild's current focus -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-amber-900/30 via-midnight-900 to-midnight-900"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-500/60 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-10 lg:pt-28 lg:pb-14">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/40 text-amber-300 text-sm font-medium rounded-full px-4 py-1.5 mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
          </span>
          Now playing: {guild.nowPlaying}
        </div>
        <img src="/images/pixel goat big.png" alt="Goat Guild" class="w-24 h-24 mx-auto mb-4" />
        <h1 class="font-display text-4xl md:text-6xl font-bold text-accent-gold mb-4">
          {guild.name}
        </h1>
        <p class="text-xl md:text-2xl text-gray-200 font-display mb-3">{guild.tagline}</p>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-8">
          {guild.description}
        </p>

        {guild.recruitmentStatus !== 'Closed' && (
          <p class="text-gray-300 mb-8">
            <strong class="text-green-400">Recruiting:</strong> {guild.recruitmentNote}
          </p>
        )}

        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={guild.discordLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent-purple hover:bg-accent-purple/80 text-white font-medium px-6 py-3 rounded-lg transition-colors"
          >
            Join Our Discord
          </a>
          <a
            href="/wow-forever"
            class="bg-accent-gold hover:bg-accent-gold/80 text-midnight-900 font-medium px-6 py-3 rounded-lg transition-colors"
          >
            See the Roster
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pinned Announcements -->
  {pinnedNews.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-10">
      <div class="grid gap-4">
        {pinnedNews.map(post => (
          <NewsCard post={post} />
        ))}
      </div>
    </section>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">

    <!-- The Climb to 60 -->
    <section id="leveling">
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-gray-100 mb-1 flex items-center gap-2">
        <span>🏔️</span> The Climb to 60
      </h2>
      <p class="text-gray-400 mb-5">Everyone's leveling in WoW: Forever. Here's how the herd is doing.</p>
      <ForeverLeveling />
    </section>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Guild news -->
      <section id="news" class="lg:col-span-1">
        <h2 class="font-display text-2xl font-semibold text-gray-100 mb-4 flex items-center gap-2">
          <span>📰</span> Guild News
        </h2>
        <div class="space-y-4">
          {recentNews.map(post => (
            <NewsCard post={post} />
          ))}
        </div>
      </section>

      <!-- Forever blue posts -->
      <section id="forever-news" class="lg:col-span-2">
        <h2 class="font-display text-2xl font-semibold text-gray-100 mb-4 flex items-center gap-2">
          <span>💬</span> WoW: Forever Blue Posts
        </h2>
        <BluePosts game="forever" limit={6} />
      </section>
    </div>

    <!-- Retail: on the back burner while the guild levels in Forever -->
    <section id="retail">
      <h2 class="font-display text-2xl font-semibold text-gray-100 mb-1 flex items-center gap-2">
        <span>⚔️</span> Retail
      </h2>
      <p class="text-gray-400 mb-5">On the back burner while we level in Forever. Progression on {guild.server} is still tracked automatically.</p>

      <details id="progression" class="group bg-midnight-800 rounded-lg border border-midnight-500 mb-4">
        <summary class="cursor-pointer p-4 font-semibold text-gray-100 hover:bg-midnight-700 rounded-lg transition-colors">
          Raid progression: {currentTier[0]?.name ?? 'Current tier'}
        </summary>
        <div class="p-4 pt-0 space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            {currentTier.map(raid => (
              <ProgressionCard raid={raid} />
            ))}
          </div>

          <details class="bg-midnight-900/50 rounded-lg border border-midnight-600">
            <summary class="cursor-pointer p-3 text-sm font-semibold text-gray-200">🌙 Midnight Season 1</summary>
            <div class="grid sm:grid-cols-2 gap-4 p-3 pt-0">
              {midnightS1Tier.map(raid => (
                <ProgressionCard raid={raid} />
              ))}
            </div>
          </details>

          <details class="bg-midnight-900/50 rounded-lg border border-midnight-600">
            <summary class="cursor-pointer p-3 text-sm font-semibold text-gray-200">📜 The War Within</summary>
            <div class="grid sm:grid-cols-2 gap-4 p-3 pt-0">
              {twwTier.map(raid => (
                <ProgressionCard raid={raid} />
              ))}
            </div>
          </details>

          {achievements.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {achievements.map(achievement => (
                <span class="bg-accent-gold/20 text-accent-gold text-sm px-3 py-1 rounded-full">
                  🏆 {achievement.name}
                </span>
              ))}
            </div>
          )}
        </div>
      </details>

      <details id="schedule" class="bg-midnight-800 rounded-lg border border-midnight-500 mb-4">
        <summary class="cursor-pointer p-4 font-semibold text-gray-100 hover:bg-midnight-700 rounded-lg transition-colors">
          Raid schedule &amp; sign-ups
        </summary>
        <div class="p-4 pt-0 space-y-4">
          <ScheduleTable />
          <a
            href={guild.raidSignupForm}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-midnight-600 hover:bg-midnight-500 text-gray-100 font-medium px-4 py-2 rounded-lg transition-colors"
          >
            Raid sign-ups{nextRaidIsUpcoming && ` (${nextRaidFormatted})`}
          </a>
        </div>
      </details>

      <details class="bg-midnight-800 rounded-lg border border-midnight-500 mb-4">
        <summary class="cursor-pointer p-4 font-semibold text-gray-100 hover:bg-midnight-700 rounded-lg transition-colors">
          Retail blue posts
        </summary>
        <div class="p-4 pt-0">
          <BluePosts game="retail" limit={6} />
        </div>
      </details>

      <details id="addons" class="bg-midnight-800 rounded-lg border border-midnight-500">
        <summary class="cursor-pointer p-4 font-semibold text-gray-100 hover:bg-midnight-700 rounded-lg transition-colors">
          🔧 Raiding addons &amp; profiles
        </summary>
        <div class="p-4 pt-0">
          <AddonList />
        </div>
      </details>
    </section>
  </div>
</Layout>
