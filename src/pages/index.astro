  <!-- Hero: WoW: Forever is the guild's current focus -->
  <ParallaxSky snow flag class="min-h-[620px] h-[78svh] md:h-[92svh] max-h-[880px] -mt-[67px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 lg:pt-36 pb-10 text-center">
      <div class="inline-flex items-center gap-2.5 bg-midnight-900/70 text-goat-moon font-pixel text-[11px] uppercase tracking-widest px-3 py-2 mb-8 panel" style="--edge: theme('colors.goat.gold-dark'); --panel: rgb(11 14 28 / 0.7)">
        <span class="h-2 w-2 bg-goat-gold animate-[blink_1.2s_steps(1)_infinite]"></span>
        Now playing: {guild.nowPlaying}
      </div>
      <img src="/images/pixel goat big.png" alt="" class="w-24 h-24 md:w-28 md:h-28 mx-auto mb-5 pixelated goat-bob" />
      <h1 class="font-display text-5xl md:text-7xl font-bold text-goat-gold mb-4 tracking-wide hero-title">
        {guild.name}
      </h1>
      <p class="text-xl md:text-2xl text-gray-100 font-display mb-3">{guild.tagline}</p>
      <p class="text-base md:text-lg text-gray-400 max-w-xl mx-auto mb-8">
        {guild.description}
      </p>

      {summitGoats.length > 0 && (
        <div class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 bg-midnight-900/70 px-4 py-2.5 mb-8 panel text-sm" style="--panel: rgb(11 14 28 / 0.7)">
          <span class="inline-flex items-center gap-2 font-pixel text-[10px] uppercase tracking-wider text-goat-moon">
            <svg viewBox="0 0 7 9" width="14" height="18" shape-rendering="crispEdges" aria-hidden="true">
              <rect x="0" y="0" width="1" height="9" fill="#9C5A3C" />
              <rect x="1" y="0" width="5" height="1" fill="#FFC20E" />
              <rect x="1" y="1" width="6" height="2" fill="#FFC20E" />
              <rect x="1" y="3" width="4" height="1" fill="#FFC20E" />
              <rect x="5" y="3" width="1" height="1" fill="#B5850A" />
            </svg>
            At level {foreverRoster!.maxLevel}
          </span>
          {summitGoats.map((m, i) => (
            <span class={`font-medium ${nameClass(m.classId)}`}>{m.name}{i < summitGoats.length - 1 && <span class="text-gray-600 ml-3" aria-hidden="true">/</span>}</span>
          ))}
        </div>
      )}

      {guild.recruitmentStatus !== 'Closed' && (
        <p class="text-gray-300 mb-8 text-sm md:text-base">
          <span class="tag bg-emerald-500/15 text-emerald-300 mr-2 align-middle">Recruiting</span>{guild.recruitmentNote}
        </p>
      )}

      <div class="flex flex-wrap justify-center gap-4">
        <a href={guild.discordLink} target="_blank" rel="noopener noreferrer" class="btn btn-gold">
          Join the Discord
        </a>
        <a href="/wow-forever" class="btn">
          See the roster
        </a>
      </div>
    </div>
  </ParallaxSky>

  <!-- Pinned Announcements -->
  {pinnedNews.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-4 relative z-10">
      <div class="grid gap-4">
        {pinnedNews.map(post => (
          <NewsCard post={post} />
        ))}
      </div>
    </section>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-12 space-y-16">

    <!-- The Climb to 60 -->
    <section id="leveling" class="reveal">
      <h2 class="section-title text-2xl md:text-3xl mb-2">
        The Climb to 60
      </h2>
      <p class="text-gray-400 mb-6">Everyone's leveling in WoW: Forever. Here's how the herd is doing.</p>
      <SummitWatch />
      <ForeverLeveling />
      <div class="mt-8">
        <HerdSkyline />
      </div>
      <div class="mt-8">
        <HerdPasture />
      </div>
    </section>

    <div class="grid lg:grid-cols-3 gap-10">
      <!-- Guild news -->
      <section id="news" class="lg:col-span-1 reveal">
        <h2 class="section-title text-2xl mb-5">
          Guild News
        </h2>
        <div class="space-y-4">
          {recentNews.map(post => (
            <NewsCard post={post} />
          ))}
        </div>
      </section>

      <!-- Forever blue posts -->
      <section id="forever-news" class="lg:col-span-2 reveal">
        <h2 class="section-title text-2xl mb-5">
          WoW: Forever Blue Posts
        </h2>
        <BluePosts game="forever" limit={6} />
      </section>
    </div>

    <!-- Retail: on the back burner while the guild levels in Forever -->
    <section id="retail" class="reveal">
      <h2 class="section-title text-2xl mb-2">
        Retail
      </h2>
      <p class="text-gray-400 mb-5">On hold while we level in Forever. Raider.io keeps tracking {guild.server} either way.</p>

      <details id="progression" class="pixel-details panel mb-5">
        <summary>
          Raid progression: {currentTier[0]?.name ?? 'Current tier'}
        </summary>
        <div class="p-4 pt-0 space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            {currentTier.map(raid => (
              <ProgressionCard raid={raid} />
            ))}
          </div>

          <details class="pixel-details panel panel-inset">
            <summary class="!p-3 !text-sm">Midnight Season 1</summary>
            <div class="grid sm:grid-cols-2 gap-4 p-3 pt-0">
              {midnightS1Tier.map(raid => (
                <ProgressionCard raid={raid} />
              ))}
            </div>
          </details>

          <details class="pixel-details panel panel-inset">
            <summary class="!p-3 !text-sm">The War Within</summary>
            <div class="grid sm:grid-cols-2 gap-4 p-3 pt-0">
              {twwTier.map(raid => (
                <ProgressionCard raid={raid} />
              ))}
            </div>
          </details>

          {achievements.length > 0 && (
            <div class="flex flex-wrap gap-3">
              {achievements.map(achievement => (
                <span class="tag bg-goat-gold/15 text-goat-gold">
                  {achievement.name}
                </span>
              ))}
            </div>
          )}
        </div>
      </details>

      <details id="schedule" class="pixel-details panel mb-5">
        <summary>
          Raid schedule &amp; sign-ups
        </summary>
        <div class="p-4 pt-0 space-y-4">
          <ScheduleTable />
          <a
            href={guild.raidSignupForm}
            target="_blank"
            rel="noopener noreferrer"
            class="btn"
          >
            Raid sign-ups{nextRaidIsUpcoming && ` (${nextRaidFormatted})`}
          </a>
        </div>
      </details>

      <details class="pixel-details panel mb-5">
        <summary>
          Retail blue posts
        </summary>
        <div class="p-4 pt-0">
          <BluePosts game="retail" limit={6} />
        </div>
      </details>

      <details id="addons" class="pixel-details panel">
        <summary>
          Raiding addons &amp; profiles
        </summary>
        <div class="p-4 pt-0">
          <AddonList />
        </div>
      </details>
    </section>
  </div>
</Layout>
