---
import { schedule } from '../data/guild';
import { upcomingEvents } from '../data/news';

const typeColors: Record<string, string> = {
  Progression: 'text-purple-400',
  'Alt Run / Cleanup': 'text-blue-400',
};

// Hide events that have already happened (compared at build time; the site rebuilds daily)
const today = new Date().toISOString().slice(0, 10);
const futureEvents = upcomingEvents.filter(event => event.date >= today);

const eventTypeColors: Record<string, string> = {
  raid: 'bg-purple-500',
  social: 'bg-green-500',
  meeting: 'bg-blue-500',
  other: 'bg-gray-500',
};
---

<div class="space-y-6">
  <!-- Regular Raid Schedule -->
  <div class="panel panel-inset p-4">
    <h4 class="eyebrow mb-4">
      Raid Schedule
    </h4>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b-2 border-midnight-600">
            <th class="text-left py-2 px-3 font-pixel text-[10px] uppercase tracking-wider text-gray-500 font-normal">Day</th>
            <th class="text-left py-2 px-3 font-pixel text-[10px] uppercase tracking-wider text-gray-500 font-normal">Time</th>
            <th class="text-left py-2 px-3 font-pixel text-[10px] uppercase tracking-wider text-gray-500 font-normal">Type</th>
          </tr>
        </thead>
        <tbody>
          {schedule.map(slot => (
            <tr class="border-b border-midnight-600 last:border-0">
              <td class="py-2 px-3 font-medium text-gray-100">{slot.day}</td>
              <td class="py-2 px-3 text-gray-300">{slot.time} {slot.timezone}</td>
              <td class={`py-2 px-3 ${typeColors[slot.type] || 'text-gray-300'}`}>{slot.type}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Upcoming Events -->
  <div class="panel panel-inset p-4">
    <h4 class="eyebrow mb-4">
      Upcoming Events
    </h4>
    <div class="space-y-3">
      {futureEvents.length === 0 && (
        <p class="text-sm text-gray-400">No events scheduled right now. Check Discord for updates.</p>
      )}
      {futureEvents.slice(0, 5).map(event => {
        const eventDate = new Date(event.date + 'T00:00:00');
        const formattedDate = eventDate.toLocaleDateString('en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric',
        });
        
        return (
          <div class="flex items-start gap-3 p-3 bg-midnight-900/60">
            <div class={`w-1 h-full self-stretch ${eventTypeColors[event.type]}`}></div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <h5 class="font-medium text-gray-100">{event.title}</h5>
                <span class="text-xs text-gray-500 shrink-0">{formattedDate}</span>
              </div>
              <p class="text-sm text-gray-400 mt-1">{event.time}</p>
              <p class="text-sm text-gray-500 mt-1">{event.description}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>
