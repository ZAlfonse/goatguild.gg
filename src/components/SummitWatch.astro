---
// "Near the summit": every goat from level 10 up, drawn as a class sprite on a mountain that runs
// from 10 to the WoW: Forever cap. The chart zooms and pans; names appear over heads when zoomed in.
// The list beside it is the top 8. Everything comes from generated/forever-roster.json.
import { foreverRoster as r, classKey, nameClass } from '../data/foreverRoster';
import { renderSprite, CLASS_HEX, SPRITE_W, SPRITE_H } from '../data/classSprites';

const maxLevel = r?.maxLevel ?? 60;
const floor = 10;
// Everyone on the mountain; the side list only shows the top 8
const climbers = (r?.members ?? []).filter(m => (m.level ?? 0) >= floor);
const contenders = climbers.slice(0, 8);
const atTop = contenders.filter(m => (m.level ?? 0) >= maxLevel);
const leader = contenders[0];

// Scene size in SVG units
const VW = 520;
const VH = 190;
const base = { x: 40, y: 172 };
const peak = { x: 470, y: 52 };

// The slope is a staircase; keep its steps so goats can stand on them exactly
const STEP = 6;
const nSteps = Math.round((peak.x - base.x) / STEP);
const stepX = Array.from({ length: nSteps + 1 }, (_, k) => Math.round(base.x + ((peak.x - base.x) * k) / nSteps));
const stepY = Array.from({ length: nSteps + 1 }, (_, k) => Math.round(base.y + ((peak.y - base.y) * k) / nSteps));
const groundAt = (x: number) => {
  const k = stepX.findIndex(sx => sx >= x);
  return k <= 0 ? base.y : stepY[k - 1];
};

// Turn a polyline into a staircase so slopes read as pixel art
const stairs = (pts: [number, number][], step = STEP) => {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const n = Math.max(1, Math.round(Math.abs(x1 - x0) / step));
    for (let k = 1; k <= n; k++) {
      d += `H${Math.round(x0 + ((x1 - x0) * k) / n)}V${Math.round(y0 + ((y1 - y0) * k) / n)}`;
    }
  }
  return d;
};
const farRange = stairs([[0, VH], [0, 160], [70, 130], [130, 155], [210, 100], [300, 148], [360, 115], [VW, 170]]) + `V${VH}Z`;
const mountain = stairs([[0, VH], [0, base.y], [base.x, base.y], [peak.x, peak.y], [VW, 140]]) + `V${VH}Z`;

// One sprite per class, defined once and reused
const spriteClasses = [...new Set(climbers.map(m => classKey(m.classId) ?? 'none'))];
const sprites = spriteClasses.map(cls => ({ id: `gg-sprite-${cls}`, paths: renderSprite(cls === 'none' ? null : cls) }));

// Place goats: by level along the slope, same-level goats side by side
const byLevel: Record<number, number> = {};
const counts: Record<number, number> = {};
climbers.forEach(m => { counts[m.level!] = (counts[m.level!] ?? 0) + 1; });
const goats = climbers
  .map(m => {
    const level = m.level!;
    const t = Math.min(1, (level - floor) / (maxLevel - floor));
    const j = (byLevel[level] = (byLevel[level] ?? -1) + 1);
    const x = Math.round(base.x + (peak.x - base.x) * t + (j - (counts[level] - 1) / 2) * 6);
    const summit = level >= maxLevel;
    // Goats at the cap stand on the snowcap, which is flat at the peak's height
    const ground = summit ? peak.y : groundAt(x);
    const cls = classKey(m.classId);
    return {
      m,
      summit,
      cx: x,
      x: x - Math.floor(SPRITE_W / 2),
      y: ground - SPRITE_H + 1,
      headY: ground - SPRITE_H + 2,
      sprite: `gg-sprite-${cls ?? 'none'}`,
      color: (cls && CLASS_HEX[cls]) || '#d1d5db',
    };
  })
  .sort((a, b) => a.cx - b.cx)
  // name tags alternate between three heights so neighbors don't sit on each other
  .map((g, i) => ({ ...g, tier: i % 3 }));

const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);
let headline = '';
if (atTop.length > 0) {
  headline = `${atTop.length} ${plural(atTop.length, 'goat', 'goats')} at the summit.`;
} else if (leader) {
  const tied = contenders.filter(m => m.level === leader.level).length;
  const gap = maxLevel - (leader.level ?? 0);
  headline = `Nobody at ${maxLevel} yet. ${tied > 1 ? `${tied} goats are` : `${leader.name} is`} ${gap} ${plural(gap, 'level', 'levels')} short.`;
}
---

{r && climbers.length > 0 && (
  <div class="panel panel-inset overflow-hidden mb-8">
    <div class="grid md:grid-cols-5">
      <div class="md:col-span-3 relative bg-[#262c52] summit" data-summit data-w={VW} data-h={VH}>
        <svg viewBox={`0 0 ${VW} ${VH}`} class="w-full h-auto block select-none" shape-rendering="crispEdges" role="img" aria-label={`${climbers.length} goats level ${floor} and up, placed on a mountain by level`}>
          <defs>
            {sprites.map(s => (
              <g id={s.id}>{s.paths.map(p => <path d={p.d} fill={p.fill} />)}</g>
            ))}
          </defs>
          <rect width={VW} height="64" fill="#0c1022" />
          <rect y="64" width={VW} height="64" fill="#10142a" />
          <rect y="128" width={VW} height={VH - 128} fill="#141933" />
          <!-- far range -->
          <path d={farRange} fill="#1c2244" />
          <!-- the mountain, with a lit edge -->
          <path d={mountain} fill="#3a4170" />
          <path d={mountain} fill="#262c52" transform="translate(0 3)" />
          <!-- snowcap -->
          <path d={`M${peak.x - 24} ${peak.y + 9}h6v-3h6v-3h6v-3h12v3h6v3h6v3h-6v3h-12v-3h-12v3h-12z`} fill="#c7cdea" />
          <!-- level ticks along the ridge -->
          {Array.from({ length: Math.floor((maxLevel - floor) / 10) }, (_, i) => floor + i * 10).map(l => {
            const t = (l - floor) / (maxLevel - floor);
            const x = base.x + (peak.x - base.x) * t;
            const y = base.y + (peak.y - base.y) * t;
            return <text x={x + 6} y={y + 13} fill="#8b93bd" font-size="10" font-family="Silkscreen, monospace">{l}</text>;
          })}
          <!-- flag at the cap -->
          <rect x={peak.x - 1} y={peak.y - 24} width="2" height="24" fill="#FFC20E" />
          <path d={`M${peak.x + 1} ${peak.y - 24}h14v3h-4v3h4v3h-14z`} fill="#FFC20E" />
          <text x={peak.x - 6} y={peak.y - 14} text-anchor="end" fill="#FFC20E" font-size="12" font-weight="700" font-family="'Pixelify Sans', monospace">{maxLevel}</text>
          <!-- the goats. Position on the group and animate the <use>: Firefox treats x/y on <use> as part of its transform -->
          {goats.map(g => (
            <g transform={`translate(${g.x} ${g.y})`}>
              <use href={`#${g.sprite}`} class={g.summit ? 'summit-hop' : undefined} style={g.summit ? `animation-delay: -${(g.cx % 7) * 0.37}s` : undefined}>
                <title>{`${g.m.name}, level ${g.m.level}`}</title>
              </use>
            </g>
          ))}
          <!-- name tags, sized in screen pixels by the script below -->
          <g class="summit-names" shape-rendering="auto">
            {goats.map(g => (
              <g class="summit-name" data-x={g.cx} data-y={g.headY} data-tier={g.tier}>
                <line x1="0" y1="-2" x2="0" y2="-2" stroke={g.color} stroke-opacity="0.5" stroke-width="1" />
                <text x="0" y="0" text-anchor="middle" fill={g.color}>{g.m.name}</text>
              </g>
            ))}
          </g>
        </svg>

        <div class="absolute top-2 left-2 flex gap-1">
          <button type="button" class="summit-btn" data-zoom="in" aria-label="Zoom in">+</button>
          <button type="button" class="summit-btn" data-zoom="out" aria-label="Zoom out">-</button>
          <button type="button" class="summit-btn summit-reset" data-zoom="reset" aria-label="Reset zoom">Reset</button>
        </div>
        <p class="summit-hint absolute bottom-2 left-3 font-pixel text-[9px] uppercase tracking-wider text-gray-400 pointer-events-none">Zoom in for names</p>
      </div>
      <div class="md:col-span-2 p-5 md:border-l-2 border-t-2 md:border-t-0 border-midnight-600">
        <h3 class="section-title text-lg">Near the summit</h3>
        <p class="text-sm text-gray-400 mb-4">{headline}</p>
        <ol class="space-y-1.5">
          {contenders.map(m => (
            <li class="flex items-center gap-2 text-sm">
              <span class={`flex-1 truncate font-medium ${nameClass(m.classId)}`}>{m.name}</span>
              <span class={`tabular-nums font-medium ${(m.level ?? 0) >= maxLevel ? 'text-goat-gold font-bold' : 'text-gray-200'}`}>{m.level}</span>
              <span class="w-16 text-right text-xs text-gray-500">
                {(m.level ?? 0) >= maxLevel ? <span class="text-goat-gold">at the top</span> : `${maxLevel - (m.level ?? 0)} to go`}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
)}

<style>
  .summit svg { touch-action: pan-y; }
  .summit[data-zoomed] svg { touch-action: none; cursor: grab; }
  .summit[data-dragging] svg { cursor: grabbing; }

  .summit-names { display: none; }
  .summit[data-names] .summit-names { display: inline; }
  .summit[data-names] .summit-hint { opacity: 0; }
  .summit-hint { transition: opacity 0.2s; }
  .summit-name text {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    paint-order: stroke;
    stroke: #0b0e1c;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .summit-btn {
    @apply font-display text-sm leading-none text-gray-200 bg-midnight-800/90 hover:bg-midnight-600 hover:text-goat-gold
      min-w-[26px] h-[26px] px-2 transition-colors;
    box-shadow: 0 0 0 2px theme('colors.midnight.600');
  }
  .summit-reset { @apply text-xs hidden; }
  .summit[data-zoomed] .summit-reset { @apply inline-block; }

  /* Goats at the cap hop, turn around, and hop some more. Offset delays keep them out of sync. */
  .summit-hop {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: summit-hop 2.6s steps(1, end) infinite;
  }
  @keyframes summit-hop {
    0%   { transform: translateY(0); }
    8%   { transform: translateY(-3px); }
    14%  { transform: translateY(-6px); }
    20%  { transform: translateY(-3px); }
    26%  { transform: translateY(0); }
    34%  { transform: translateY(-4px); }
    40%  { transform: translateY(0); }
    50%  { transform: scaleX(-1) translateY(0); }
    58%  { transform: scaleX(-1) translateY(-3px); }
    64%  { transform: scaleX(-1) translateY(-6px); }
    70%  { transform: scaleX(-1) translateY(-3px); }
    76%  { transform: scaleX(-1) translateY(0); }
    84%  { transform: scaleX(-1) translateY(-4px); }
    90%  { transform: scaleX(-1) translateY(0); }
    100% { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .summit-hop { animation: none; }
  }
</style>

<script>
  // Zoom and pan by rewriting the SVG viewBox. Name tags are scaled by 1/(px per unit) so they
  // stay 11px on screen at every zoom, and they only show once there is room to read them.
  const TIER_PX = [10, 24, 38];
  const NAMES_AT = 3.2; // screen px per SVG unit before names show

  document.querySelectorAll<HTMLElement>('[data-summit]').forEach(root => {
    const svg = root.querySelector('svg')!;
    const W = Number(root.dataset.w);
    const H = Number(root.dataset.h);
    const names = [...root.querySelectorAll<SVGGElement>('.summit-name')].map(el => ({
      el,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      lift: TIER_PX[Number(el.dataset.tier)] ?? 10,
      line: el.querySelector('line')!,
      text: el.querySelector('text')!,
    }));
    names.forEach(n => {
      n.line.setAttribute('y2', String(-n.lift + 3));
      n.text.setAttribute('y', String(-n.lift));
    });

    let vb = { x: 0, y: 0, w: W, h: H };
    const pxPerUnitAt1 = () => svg.getBoundingClientRect().width / W;
    const maxZoom = () => Math.max(8, 9 / pxPerUnitAt1());

    const apply = () => {
      vb.w = Math.min(W, vb.w);
      vb.h = vb.w * (H / W);
      vb.x = Math.min(Math.max(0, vb.x), W - vb.w);
      vb.y = Math.min(Math.max(0, vb.y), H - vb.h);
      svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
      const zoom = W / vb.w;
      const px = svg.getBoundingClientRect().width / vb.w;
      root.toggleAttribute('data-zoomed', zoom > 1.01);
      root.toggleAttribute('data-names', px >= NAMES_AT);
      if (px >= NAMES_AT) {
        const s = 1 / px;
        for (const n of names) n.el.setAttribute('transform', `translate(${n.x} ${n.y}) scale(${s})`);
      }
    };

    const toUnits = (clientX: number, clientY: number) => {
      const rect = svg.getBoundingClientRect();
      return { x: vb.x + ((clientX - rect.left) / rect.width) * vb.w, y: vb.y + ((clientY - rect.top) / rect.height) * vb.h };
    };
    const zoomAt = (factor: number, cx: number, cy: number) => {
      const zoom = Math.min(maxZoom(), Math.max(1, (W / vb.w) * factor));
      const w = W / zoom;
      const h = w * (H / W);
      vb = { x: cx - (cx - vb.x) * (w / vb.w), y: cy - (cy - vb.y) * (h / vb.h), w, h };
      apply();
    };
    const center = () => ({ x: vb.x + vb.w / 2, y: vb.y + vb.h / 2 });

    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(btn => {
      btn.addEventListener('click', () => {
        const c = center();
        if (btn.dataset.zoom === 'in') zoomAt(1.8, c.x, c.y);
        else if (btn.dataset.zoom === 'out') zoomAt(1 / 1.8, c.x, c.y);
        else { vb = { x: 0, y: 0, w: W, h: H }; apply(); }
      });
    });

    // Scrolling over the chart zooms. At the zoom limits the scroll passes through to the page,
    // so scrolling down past a zoomed-out chart (or up past a fully zoomed one) never gets stuck.
    svg.addEventListener('wheel', e => {
      // Firefox mouse wheels report lines, not pixels
      const dy = Math.max(-120, Math.min(120, e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY));
      const zoom = W / vb.w;
      if ((dy > 0 && zoom <= 1.001) || (dy < 0 && zoom >= maxZoom() - 0.001)) return;
      e.preventDefault();
      const p = toUnits(e.clientX, e.clientY);
      zoomAt(Math.exp(-dy * 0.004), p.x, p.y);
    }, { passive: false });

    svg.addEventListener('dblclick', e => {
      e.preventDefault();
      const p = toUnits(e.clientX, e.clientY);
      zoomAt(2, p.x, p.y);
    });

    // Drag to pan, two fingers to pinch
    const pointers = new Map<number, { x: number; y: number }>();
    let pinchDist = 0;
    svg.addEventListener('pointerdown', e => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
      }
      if (root.hasAttribute('data-zoomed') || pointers.size === 2) {
        svg.setPointerCapture(e.pointerId);
        root.toggleAttribute('data-dragging', true);
      }
    });
    svg.addEventListener('pointermove', e => {
      const prev = pointers.get(e.pointerId);
      if (!prev) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchDist > 0) {
          const mid = toUnits((a.x + b.x) / 2, (a.y + b.y) / 2);
          zoomAt(dist / pinchDist, mid.x, mid.y);
        }
        pinchDist = dist;
      } else if (root.hasAttribute('data-zoomed') && svg.hasPointerCapture(e.pointerId)) {
        const rect = svg.getBoundingClientRect();
        vb.x -= ((e.clientX - prev.x) / rect.width) * vb.w;
        vb.y -= ((e.clientY - prev.y) / rect.height) * vb.h;
        apply();
      }
    });
    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinchDist = 0;
      if (pointers.size === 0) root.removeAttribute('data-dragging');
    };
    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);

    window.addEventListener('resize', apply);
    apply();
  });
</script>
