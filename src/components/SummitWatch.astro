---
// "Near the summit": every goat from level 10 up, drawn on a mountain that runs from 10 to the
// WoW: Forever cap. The list beside it is the top 8.
// Everything is computed from generated/forever-roster.json; nothing here is hand-written data.
import { foreverRoster as r, classKey, nameClass } from '../data/foreverRoster';

const maxLevel = r?.maxLevel ?? 60;
const floor = 10;
// Everyone on the mountain; the side list only shows the top 8
const climbers = (r?.members ?? []).filter(m => m.level >= floor);
const contenders = climbers.slice(0, 8);
const atTop = contenders.filter(m => m.level >= maxLevel);
const leader = contenders[0];

// Raw hex so the SVG fill works without Tailwind (matches tailwind.config.mjs class colors)
const HEX: Record<string, string> = {
  warrior: '#C79C6E', paladin: '#F58CBA', hunter: '#ABD473', rogue: '#FFF569', priest: '#FFFFFF',
  shaman: '#0070DE', mage: '#69CCF0', warlock: '#9482C9', druid: '#FF7D0A',
};

// Ridge runs from the base (floor level) to the peak (max level)
const base = { x: 40, y: 150 };
const peak = { x: 470, y: 30 };
const seen: Record<number, number> = {};
const markers = climbers.map(m => {
  const t = Math.min(1, (m.level - floor) / (maxLevel - floor));
  const stack = (seen[m.level] = (seen[m.level] ?? -1) + 1);
  const x = base.x + (peak.x - base.x) * t;
  const y = base.y + (peak.y - base.y) * t - 7 - stack * 10;
  return { m, x, y, fill: HEX[classKey(m.classId) ?? ''] ?? '#d1d5db' };
});

// Turn a polyline into a staircase so slopes read as pixel art
const stairs = (pts: [number, number][], step = 6) => {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const n = Math.max(1, Math.round(Math.abs(x1 - x0) / step));
    for (let k = 1; k <= n; k++) {
      d += `H${Math.round(x0 + ((x1 - x0) * k) / n)}V${Math.round(y0 + ((y1 - y0) * k) / n)}`;
    }
  }
  return d;
};
const farRange = stairs([[0, 165], [0, 140], [70, 110], [130, 135], [210, 80], [300, 128], [360, 95], [520, 150]]) + 'V165Z';
const mountain = stairs([[0, 165], [0, base.y], [base.x, base.y], [peak.x, peak.y], [520, 120]]) + 'V165Z';

const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);
let headline = '';
if (atTop.length > 0) {
  headline = `${atTop.length} ${plural(atTop.length, 'goat', 'goats')} at the summit.`;
} else if (leader) {
  const tied = contenders.filter(m => m.level === leader.level).length;
  const gap = maxLevel - leader.level;
  headline = `Nobody at ${maxLevel} yet. ${tied > 1 ? `${tied} goats are` : `${leader.name} is`} ${gap} ${plural(gap, 'level', 'levels')} short.`;
}
---

{r && climbers.length > 0 && (
  <div class="panel panel-inset overflow-hidden mb-8">
    <div class="grid md:grid-cols-5">
      <div class="md:col-span-3 relative bg-[#262c52]">
        <svg viewBox="0 0 520 165" class="w-full h-auto block" shape-rendering="crispEdges" role="img" aria-label={`Goats level ${floor} and up, placed on a mountain by level`}>
          <rect width="520" height="56" fill="#0c1022" />
          <rect y="56" width="520" height="56" fill="#10142a" />
          <rect y="112" width="520" height="53" fill="#141933" />
          <!-- far range -->
          <path d={farRange} fill="#1c2244" />
          <!-- the mountain, with a lit edge -->
          <path d={mountain} fill="#3a4170" />
          <path d={mountain} fill="#262c52" transform="translate(0 3)" />
          <!-- snowcap -->
          <path d={`M${peak.x - 24}  ${peak.y + 9}h6v-3h6v-3h6v-3h12v3h6v3h6v3h-6v3h-12v-3h-12v3h-12z`} fill="#c7cdea" />
          <!-- level ticks along the ridge -->
          {Array.from({ length: Math.floor((maxLevel - floor) / 10) }, (_, i) => floor + i * 10).map(l => {
            const t = (l - floor) / (maxLevel - floor);
            const x = base.x + (peak.x - base.x) * t;
            const y = base.y + (peak.y - base.y) * t;
            return <text x={x + 6} y={y + 13} fill="#8b93bd" font-size="10" font-family="Silkscreen, monospace">{l}</text>;
          })}
          <!-- flag at the cap -->
          <rect x={peak.x - 1} y={peak.y - 24} width="2" height="24" fill="#FFC20E" />
          <path d={`M${peak.x + 1} ${peak.y - 24}h14v3h-4v3h4v3h-14z`} fill="#FFC20E" />
          <text x={peak.x - 6} y={peak.y - 14} text-anchor="end" fill="#FFC20E" font-size="12" font-weight="700" font-family="'Pixelify Sans', monospace">{maxLevel}</text>
          <!-- the goats -->
          {markers.map(({ m, x, y, fill }) => (
            <g>
              <title>{`${m.name}, level ${m.level}`}</title>
              <rect x={Math.round(x) - 5} y={Math.round(y) - 5} width="10" height="10" fill="#0b0e1c" />
              <rect x={Math.round(x) - 3} y={Math.round(y) - 3} width="6" height="6" fill={fill} />
            </g>
          ))}
        </svg>
      </div>
      <div class="md:col-span-2 p-5 md:border-l-2 border-t-2 md:border-t-0 border-midnight-600">
        <h3 class="section-title text-lg">Near the summit</h3>
        <p class="text-sm text-gray-400 mb-4">{headline}</p>
        <ol class="space-y-1.5">
          {contenders.map(m => (
            <li class="flex items-center gap-2 text-sm">
              <span class={`flex-1 truncate font-medium ${nameClass(m.classId)}`}>{m.name}</span>
              <span class={`tabular-nums font-medium ${m.level >= maxLevel ? 'text-goat-gold font-bold' : 'text-gray-200'}`}>{m.level}</span>
              <span class="w-16 text-right text-xs text-gray-500">
                {m.level >= maxLevel ? <span class="text-goat-gold">at the top</span> : `${maxLevel - m.level} to go`}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
)}
